# ----- Server -----
PORT=4000

# ----- Mode -----
DEMO_MODE=false

# ----- Blockchain -----
RPC_URL=http://127.0.0.1:8545
ORACLE_UPDATER_PRIVATE_KEY=YOUR_ORACLE_UPDATER_PRIVATE_KEY
OPERATOR_PRIVATE_KEY=YOUR_OPERATOR_PRIVATE_KEY
POLICY_REGISTRY_ADDRESS=YOUR_POLICY_REGISTRY_ADDRESS
LIQUIDITY_VAULT_ADDRESS=YOUR_LIQUIDITY_VAULT_ADDRESS
ORACLE_AGGREGATOR_ADDRESS=YOUR_ORACLE_AGGREGATOR_ADDRESS
PARAMETRIC_ENGINE_ADDRESS=YOUR_PARAMETRIC_ENGINE_ADDRESS

# Three separate authorized oracle-node wallets, comma separated.
ORACLE_NODE_PRIVATE_KEYS=NODE_KEY_1,NODE_KEY_2,NODE_KEY_3

# ----- Live oracle monitoring -----
LIVE_ORACLE_ENABLED=true
ORACLE_POLL_INTERVAL_SECONDS=900
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# ----- Prototype normalization baselines -----
RAINFALL_BASELINE_MM=35
TEMPERATURE_BASELINE_C=30
DRY_DAY_RAIN_THRESHOLD_MM=1
OPENWEATHER_RAIN_BASELINE_MM=5
